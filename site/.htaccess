DirectoryIndex index.html index.htm
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On
# личная ссылка ученика: /s/<код> → вход
RewriteRule ^s/([A-Za-z0-9]{6,16})/?$ api/enter.php?t=$1 [L,QSA]
# личная ссылка преподавателя: /t/<код> → вход в кабинет
RewriteRule ^t/([A-Za-z0-9]{6,16})/?$ api/enter.php?r=t&t=$1 [L,QSA]
# страницы курсов — только после входа по коду (учитель или ученик)
RewriteRule ^(unit[0-9]{2})/?$ api/gate.php?f=$1/index.html [L]
RewriteRule ^(unit[0-9]{2}/[a-z]+\.html)$ api/gate.php?f=$1 [L]
# аудио и видео курса — тоже только после входа (api/media.php отдаёт с поддержкой Range)
RewriteRule ^media/(.*)$ api/media.php?f=$1 [L,B]
</IfModule>

# служебный файл сборки не отдаётся
<FilesMatch "^(catalog-build\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
